---
import '../styles/tokens.css';
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { site } from '../config/site';
import { media } from '../config/media';

interface Props {
  title?: string;
}

const { title = site.title } = Astro.props;
---

<!DOCTYPE html>
<html lang={site.lang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <!-- viewport-fit=cover：让底板铺到刘海/圆角区域，再用 env(safe-area-inset-*) 让内容避开 -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#05050a" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}favicon/favicon.png`} />
  </head>
  <body>
    <slot />

    <!--
      爱发电收款卡弹层（文章页「请我喝咖啡」按钮打开）。
      刻意放在 <body> 直下：任何带 backdrop-filter / transform 的祖先都会成为
      position:fixed 的包含块，塞进底板里就只能盖住底板而不是整个视口。
      图片用 data-src 延迟到首次打开才加载（342KB），样式见 styles/global.css。
    -->
    <div class="coffee-modal" id="coffeeModal" hidden>
      <div class="coffee-modal-backdrop" data-coffee-close></div>
      <div class="coffee-modal-body" role="dialog" aria-modal="true" aria-label="请我喝咖啡">
        <button class="coffee-modal-close" type="button" data-coffee-close aria-label="关闭">×</button>
        <img
          class="coffee-modal-img"
          data-src={media.afdianCard}
          alt="爱发电 · 扫码支持 izwarm"
          width="710"
          height="765"
          decoding="async"
        />
      </div>
    </div>

    <!--
      正文图片预览（点正文里的图片打开）：滚轮缩放、拖动平移、Esc / 点空白关闭。
      同样挂在 <body> 直下 —— 理由和上面的收款卡弹层一样（底板里的 backdrop-filter
      会成为 position:fixed 的包含块，塞进底板里就只能盖住底板）。
      交互见 scripts/image-viewer.ts，样式见 styles/global.css。
    -->
    <div class="img-viewer" id="imgViewer" hidden role="dialog" aria-modal="true" aria-label="图片预览">
      <img class="img-viewer-img" alt="" decoding="async" draggable="false" />
      <div class="img-viewer-bar">
        <span class="img-viewer-scale" data-viewer-scale>100%</span>
        <button class="img-viewer-btn" type="button" data-viewer-reset>复位</button>
        <button class="img-viewer-btn img-viewer-btn--close" type="button" data-viewer-close aria-label="关闭预览">
          ×
        </button>
      </div>
    </div>
  </body>
</html>
