---
import { getCalendarData, getLatestYear } from '../../lib/notes';
import type { Note } from '../../lib/notes';

interface Props {
  notes: Note[];
}

const { notes } = Astro.props;
const year = getLatestYear(notes);
const calendar = getCalendarData(notes, year);
---

<section class="notes-calendar" aria-label={`${year} 年文章日历`}>
  <h2 class="notes-section-label">{year} 年</h2>
  <div class="notes-calendar-grid">
    {calendar.days.map((day) =>
      day.count > 0 ? (
        <a
          class="notes-cal-day"
          data-count={Math.min(day.count, 4)}
          href={`/notes/archive/#${day.date}`}
          title={`${day.date} · ${day.count} 篇`}
          aria-label={`${day.date}，${day.count} 篇文章`}
        ></a>
      ) : (
        <span class="notes-cal-day" data-count="0" aria-hidden="true"></span>
      )
    )}
  </div>
</section>
