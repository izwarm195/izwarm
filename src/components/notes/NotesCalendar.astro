---
import { getCalendarData, getCalendarYears, url } from '../../lib/notes';
import type { CommitActivity, Note } from '../../lib/notes';
import { icon } from '../../config/media';
import activity from '../../config/commit-activity.json';

interface Props {
  notes: Note[];
}

const { notes } = Astro.props;
const act = activity as CommitActivity;
const years = getCalendarYears(notes, act);
const requested = Number(Astro.url.searchParams.get('year'));
const year = years.includes(requested) ? requested : (years[0] ?? new Date().getUTCFullYear());
const calendar = getCalendarData(notes, year, act);
const base = Astro.url.pathname;

/** 亮度基准：全年单日最大提交数（下面的百分比按它归一） */
const maxCommits = calendar.days.reduce((max, day) => Math.max(max, day.commits), 0);

/**
 * 提交数 → 着色强度（32%~100%）。
 * 两种含义共用同一个强度轴，只是底色不同：
 * - 有文章的日子：主题色（--accent）；
 * - 没有文章但有提交的日子：白色。
 * 暗端留 32%：近黑底板上再暗就与空格子分不开；
 * 用 sqrt 而不是线性：vault 的提交数集中在 1~2，线性会让绝大多数格子挤在暗端。
 */
function shade(commits: number): number {
  if (commits <= 0 || maxCommits <= 0) return 32;
  return Math.round((32 + 68 * Math.sqrt(commits / maxCommits)) * 10) / 10;
}

/**
 * 按月份切成 12 行 × 31 列（列 = 日），行内不再带月份数字标签。
 * 原来的 53 列「一年一条」布局配 min-width: 420/560px，而左侧栏只有 206~286px，
 * 于是每行右侧被裁掉、滚动条又是隐藏的 —— 表现为「9-2、9-3 有，9-6 往后全黑」，
 * 其实格子都在，只是被裁在可视区外。12 行月份矩阵宽度天然贴合侧栏，不再有裁切。
 */
const calendarMonths = Array.from({ length: 12 }, (_, m) => ({
  month: m + 1,
  days: calendar.days.filter((d) => d.month === m),
}));

const legend = [
  {
    kind: 'article',
    iconName: 'note',
    tip: '有文章：深浅按当日提交数',
  },
  {
    kind: 'commit',
    iconName: 'circled-check',
    tip: '只提交、没有文章：深浅同样按当日提交数',
  },
] as const;
---

<section class="notes-calendar" aria-label={`${year} 年写作热力图`}>
  <div class="notes-calendar-head">
    <h2 class="notes-section-label">{year} 年</h2>
    {years.length > 1 && (
      <div class="notes-calendar-years" aria-label="选择年份">
        {years.map((y) => (
          <a
            class={y === year ? 'active' : undefined}
            href={`${base}?year=${y}`}
            aria-current={y === year ? 'true' : undefined}
          >
            {y}
          </a>
        ))}
      </div>
    )}
  </div>
  <div class="notes-calendar-grid">
    {calendarMonths.map(({ days }) => (
      <div class="notes-cal-row">
        {days.map((day) => {
          // 颜色只说两件事：这天有没有文章（色相）、提交了多少（深浅）。
          const kind = day.notes > 0 ? 'article' : day.commits > 0 ? 'commit' : 'empty';
          const style = `grid-column:${Number(day.date.slice(-2))};--cal-pct:${shade(day.commits)}%`;
          if (kind === 'empty') {
            return <span class="notes-cal-day" data-kind="empty" style={style} aria-hidden="true" />;
          }
          const tip =
            kind === 'article'
              ? `${day.date} · ${day.notes} 篇 · ${day.commits} 次提交`
              : `${day.date} · ${day.commits} 次提交`;
          // 只有有文章的日子能点进归档：纯提交的日子在归档里没有落点
          if (kind === 'commit') {
            return <span class="notes-cal-day" data-kind="commit" style={style} title={tip} aria-label={tip} />;
          }
          return (
            <a
              class="notes-cal-day"
              data-kind="article"
              style={style}
              href={`${url('/notes/archive/')}#${day.date}`}
              title={tip}
              aria-label={tip}
            />
          );
        })}
      </div>
    ))}
    {/* 图例与热力图之间空出一整行小格：这一行只占位，不可见、不可点 */}
    <div class="notes-cal-row notes-cal-gap" aria-hidden="true">
      <span class="notes-cal-day" data-kind="empty" style="grid-column:1" />
    </div>
  </div>
  <div class="notes-cal-legend">
    {legend.map((item) => (
      <span class="notes-cal-legend-item" title={item.tip}>
        <span class="notes-cal-day notes-cal-swatch" data-kind={item.kind} style="--cal-pct:100%" />
        <img class="notes-cal-legend-icon" src={icon(item.iconName)} alt="" width="12" height="12" />
      </span>
    ))}
  </div>
</section>
