---
import { getCalendarData, getCalendarYears, url } from '../../lib/notes';
import type { CalendarDay, CommitActivity, Note } from '../../lib/notes';
import { icon } from '../../config/media';
import activity from '../../config/commit-activity.json';
import webActivity from '../../config/web-commit-activity.json';

interface Props {
  notes: Note[];
}

const { notes } = Astro.props;
const act = activity as CommitActivity;
const webAct = webActivity as CommitActivity;
const years = getCalendarYears(notes, { ...act, ...webAct });
const requested = Number(Astro.url.searchParams.get('year'));
const year = years.includes(requested) ? requested : (years[0] ?? new Date().getUTCFullYear());
const calendar = getCalendarData(notes, year, act, webAct);
const base = Astro.url.pathname;

/** 当天提交总数：Obsidian 库 + 网站仓库。三个信号里，深度只认这一条 */
const commitsOf = (day: CalendarDay): number => day.commits + day.webCommits;

/** 亮度基准：全年单日最大提交数（下面的百分比按它归一） */
const maxCommits = calendar.days.reduce((max, day) => Math.max(max, commitsOf(day)), 0);

/**
 * 提交数 → 着色强度（32%~100%）。
 * 三种含义共用同一个强度轴，只是底色不同：
 * - 有文章的日子：主题色（--accent）；
 * - 没有文章但有提交的日子：白色。
 * 暗端留 32%：近黑底板上再暗就与空格子分不开；
 * 用 sqrt 而不是线性：vault 的提交数集中在 1~2，线性会让绝大多数格子挤在暗端。
 * 网站仓库的提交只额外加一圈金边（见 notes.css 的 [data-web]），不换底色：
 * 底色已经被「有没有文章」占住了，两个信号挤同一块颜色会互相淹没。
 */
function shade(commits: number): number {
  if (commits <= 0 || maxCommits <= 0) return 32;
  return Math.round((32 + 68 * Math.sqrt(commits / maxCommits)) * 10) / 10;
}

/** 悬停文案：三个信号各自说清楚，缺的那项不占位（否则每天都是同一串 0） */
function tipFor(day: CalendarDay): string {
  const parts = [day.date];
  if (day.notes > 0) parts.push(`${day.notes} 篇`);
  parts.push(`Obsidian ${day.commits} 次提交`);
  if (day.webCommits > 0) parts.push(`网站 ${day.webCommits} 次提交`);
  return parts.join(' · ');
}

/**
 * 顺时针转 90°：12 行（月）× 31 列（日）→ 31 行（日）× 12 列（月）。
 * 顺时针的映射是「上边 → 右边」：1 月原来在最上一行，转完落在最右一列（12 月落在最左一列）；
 * 日号原来在同一行里从左往右，转完变成从上往下（1 号在最上、31 号在最下）。
 * 不再按月份切行：整个网格是一个 12 列的 CSS grid，每个格子自己写 grid-column / grid-row。
 * DOM 顺序按「行优先」（先第 1 天那一行的 12 个月，再第 2 天……），
 * 这样 Tab 的顺序和眼睛读的顺序一致。
 */
const byMonth = Array.from({ length: 12 }, (_, m) => calendar.days.filter((d) => d.month === m));
const cells: (CalendarDay & { row: number; col: number })[] = [];
for (let day = 1; day <= 31; day++) {
  for (let col = 1; col <= 12; col++) {
    const cell = byMonth[12 - col][day - 1]; // 列 12 = 1 月，列 1 = 12 月
    if (cell) cells.push({ ...cell, row: day, col });
  }
}

const legend = [
  {
    kind: 'article',
    iconName: 'note',
    tip: '文章发表',
    web: false,
  },
  {
    kind: 'commit',
    iconName: 'circled-check',
    tip: '文章修改',
    web: false,
  },
  {
    kind: 'commit',
    iconName: 'external-link',
    tip: '网页开发',
    web: true,
  },
] as const;
---

<section class="notes-calendar" aria-label={`${year} 年写作热力图`}>
  <div class="notes-calendar-head">
    <h2 class="notes-section-label">{year} 年</h2>
    {years.length > 1 && (
      <div class="notes-calendar-years" aria-label="选择年份">
        {years.map((y) => (
          <a
            class={y === year ? 'active' : undefined}
            href={`${base}?year=${y}`}
            aria-current={y === year ? 'true' : undefined}
          >
            {y}
          </a>
        ))}
      </div>
    )}
  </div>
  <div class="notes-calendar-body">
    <div class="notes-calendar-grid">
      {cells.map(({ row, col, ...day }) => {
        // 颜色只说两件事：这天有没有文章（色相）、提交了多少（深浅）。
        // 网站仓库的提交另算第三件事，用金框标（data-web），不动底色。
        const kind = day.notes > 0 ? 'article' : commitsOf(day) > 0 ? 'commit' : 'empty';
        const web = day.webCommits > 0 ? '1' : undefined;
        const style = `grid-column:${col};grid-row:${row};--cal-pct:${shade(commitsOf(day))}%`;
        if (kind === 'empty') {
          return <span class="notes-cal-day" data-kind="empty" style={style} aria-hidden="true" />;
        }
        const tip = tipFor(day);
        // 只有有文章的日子能点进归档：纯提交的日子在归档里没有落点
        if (kind === 'commit') {
          return (
            <span class="notes-cal-day" data-kind="commit" data-web={web} style={style} title={tip} aria-label={tip} />
          );
        }
        return (
          <a
            class="notes-cal-day"
            data-kind="article"
            data-web={web}
            style={style}
            href={`${url('/notes/archive/')}#${day.date}`}
            title={tip}
            aria-label={tip}
          />
        );
      })}
    </div>
    {/* 图例竖条：贴着网格右侧，三项在网格高度内均分（恰好沾满） */}
    <div class="notes-cal-legend">
      {legend.map((item) => (
        <span class="notes-cal-legend-item" title={item.tip}>
          <span
            class="notes-cal-day notes-cal-swatch"
            data-kind={item.kind}
            data-web={item.web ? '1' : undefined}
            style="--cal-pct:100%"
          />
          <img class="notes-cal-legend-icon" src={icon(item.iconName)} alt="" width="12" height="12" />
        </span>
      ))}
    </div>
  </div>
</section>
