---
import { getCalendarData, getYears, url } from '../../lib/notes';
import type { Note } from '../../lib/notes';

interface Props {
  notes: Note[];
}

const { notes } = Astro.props;
const years = getYears(notes);
const requested = Number(Astro.url.searchParams.get('year'));
const year = years.includes(requested) ? requested : (years[0] ?? new Date().getUTCFullYear());
const calendar = getCalendarData(notes, year);
const base = Astro.url.pathname;
---

<section class="notes-calendar" aria-label={`${year} 年文章日历`}>
  <div class="notes-calendar-head">
    <h2 class="notes-section-label">{year} 年</h2>
    {years.length > 1 && (
      <div class="notes-calendar-years" aria-label="选择年份">
        {years.map((y) => (
          <a
            class={y === year ? 'active' : undefined}
            href={`${base}?year=${y}`}
            aria-current={y === year ? 'true' : undefined}
          >
            {y}
          </a>
        ))}
      </div>
    )}
  </div>
  <div class="notes-calendar-grid">
    {calendar.days.map((day) =>
      day.count > 0 ? (
        <a
          class="notes-cal-day"
          data-count={Math.min(day.count, 4)}
          href={`${url('/notes/archive/')}#${day.date}`}
          title={`${day.date} · ${day.count} 篇`}
          aria-label={`${day.date}，${day.count} 篇文章`}
        ></a>
      ) : (
        <span class="notes-cal-day" data-count="0" aria-hidden="true"></span>
      )
    )}
  </div>
</section>
