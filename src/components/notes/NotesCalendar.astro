---
import { getCalendarData, getCalendarYears, url } from '../../lib/notes';
import type { CommitActivity, Note } from '../../lib/notes';
import activity from '../../config/commit-activity.json';

interface Props {
  notes: Note[];
}

const { notes } = Astro.props;
const act = activity as CommitActivity;
const years = getCalendarYears(notes, act);
const requested = Number(Astro.url.searchParams.get('year'));
const year = years.includes(requested) ? requested : (years[0] ?? new Date().getUTCFullYear());
const calendar = getCalendarData(notes, year, act);
const base = Astro.url.pathname;

/** 当日活跃量 → 热力档位（1 次 = 1 级，4 次以上封顶 4 级）
 *  活跃量 = 当日提交数 + 当日创建/修改过的笔记数：
 *  只按提交数着色时，"写了笔记但那天没提交（vault 批量备份）"的日子会整片空白，
 *  持续写作看起来就像热力图没更新。 */
function calLevel(n: number): number {
  if (n <= 0) return 0;
  if (n === 1) return 1;
  if (n === 2) return 2;
  if (n <= 4) return 3;
  return 4;
}
---

<section class="notes-calendar" aria-label={`${year} 年写作热力图`}>
  <div class="notes-calendar-head">
    <h2 class="notes-section-label">{year} 年</h2>
    {years.length > 1 && (
      <div class="notes-calendar-years" aria-label="选择年份">
        {years.map((y) => (
          <a
            class={y === year ? 'active' : undefined}
            href={`${base}?year=${y}`}
            aria-current={y === year ? 'true' : undefined}
          >
            {y}
          </a>
        ))}
      </div>
    )}
  </div>
  <div class="notes-calendar-grid">
    {calendar.days.map((day) => {
      const level = calLevel(day.commits + day.touched);
      const parts = [
        day.commits > 0 ? `${day.commits} 次提交` : '',
        day.touched > 0 ? `${day.touched} 次编辑` : '',
        day.notes > 0 ? `${day.notes} 篇` : '',
      ].filter(Boolean);
      const tip = `${day.date} · ${parts.join(' · ')}`;
      if (parts.length === 0) {
        return <span class="notes-cal-day" data-count="0" aria-hidden="true"></span>;
      }
      // 有文章的日期仍可点击跳转到归档对应锚点；仅有提交的日期只展示热力
      if (day.notes > 0) {
        return (
          <a
            class="notes-cal-day"
            data-count={level}
            href={`${url('/notes/archive/')}#${day.date}`}
            title={tip}
            aria-label={tip}
          ></a>
        );
      }
      return <span class="notes-cal-day" data-count={level} title={tip} aria-label={tip}></span>;
    })}
  </div>
</section>
