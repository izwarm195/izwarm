---
import { buildTocTree } from '../../lib/toc';
import TocTree from './TocTree.astro';
import SeriesTree from './SeriesTree.astro';
import type { Note, SeriesNode, TocItem } from '../../lib/notes';

interface Props {
  note: Note;
  /** 全站系列树（buildSeriesTree），侧栏只按当前文章的路径决定默认展开哪一支 */
  seriesTree: SeriesNode[];
  toc: TocItem[];
}

const { note, seriesTree, toc } = Astro.props;
const tocTree = buildTocTree(toc);
const activePath = note.data.series;
---

{/*
  两侧栏都用原生 <details>：
  - 桌面端固定展开：.notes-fold-head 无标记、外观与原来的 h2 标题一致，
    点击由脚本取消折叠（见 scripts/notes.ts），电脑端体验不变；
  - 手机端由脚本收起为可点开的折叠面板，正文不再被长目录推到屏幕之外。
*/}
<div class="notes-article-side">
  <details class="notes-toc-wrap notes-fold" open>
    <summary class="notes-fold-head">
      <h2 class="notes-section-label">大纲</h2>
    </summary>
    {tocTree.length === 0 ? (
      <p class="notes-empty">本文没有可用的标题。</p>
    ) : (
      <TocTree items={tocTree} />
    )}
  </details>

  <details class="notes-series-wrap notes-fold" open>
    <summary class="notes-fold-head">
      <h2 class="notes-section-label">同系列</h2>
    </summary>
    {seriesTree.length === 0 ? (
      <p class="notes-empty">暂无同系列文章。</p>
    ) : (
      <ol class="notes-series-tree">
        {seriesTree.map((node) => (
          <SeriesTree node={node} activePath={activePath} currentSlug={note.slug} depth={1} />
        ))}
      </ol>
    )}
  </details>
</div>
