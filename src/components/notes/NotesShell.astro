---
import NotesRail from './NotesRail.astro';

interface Props {
  active: 'home' | 'article' | 'archive' | 'tags';
}

const { active } = Astro.props;
---

<div class="notes-shell" id="notesShell" data-notes-state={active}>
  <aside class="notes-col notes-left" data-notes-region="left"><slot name="left" /></aside>
  <main class="notes-col notes-main" data-notes-region="main"><slot /></main>
  <div data-notes-region="rail"><NotesRail active={active} /></div>
</div>

<script>
  import '../../scripts/notes';
</script>
