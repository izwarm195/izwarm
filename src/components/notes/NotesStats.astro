---
import { getNotesStats } from '../../lib/notes';
import type { Note } from '../../lib/notes';

interface Props {
  notes: Note[];
}

const { notes } = Astro.props;
const stats = getNotesStats(notes);
const items = [
  { label: '文章', value: stats.articles },
  { label: '系列', value: stats.series },
  { label: '标签', value: stats.tags },
  { label: '字数', value: stats.words.toLocaleString('zh-Hans-CN') },
];
---

<section class="notes-stats" aria-label="Notes 统计">
  {items.map((item) => (
    <div class="w-shape notes-stat">
      <b>{item.value}</b>
      <span>{item.label}</span>
    </div>
  ))}
</section>
