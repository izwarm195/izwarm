---
import { url } from '../../lib/notes';
import { media } from '../../config/media';

interface Props {
  active: 'home' | 'article' | 'archive' | 'tags';
}

const { active } = Astro.props;

const items = [
  { label: 'Home', href: url('/notes/'), key: 'home' },
  { label: 'Tags', href: url('/notes/tags/'), key: 'tags' },
  { label: 'Archive', href: url('/notes/archive/'), key: 'archive' },
];

// 手机端底部工具栏里的「返回首页」按钮：沿用 W —— 它在桌面端就是 Notes 的锚点字母，
// 点它回主页展开态。桌面端这一栏由常驻的 W 承担，所以 .rail-home 在宽屏隐藏。
---

<nav class="notes-rail" aria-label="Notes 导航">
  <ul class="notes-rail-menu">
    {items.map((item) => (
      <li>
        <a
          class="w-shape notes-rail-link"
          href={item.href}
          aria-current={active === item.key ? 'page' : undefined}
        >
          {item.label}
        </a>
      </li>
    ))}
  </ul>
  <!-- ?letters=1：主页加载后直接落到「字母已展开」态，用户不必再点一下背景才看到 w/a/r/m -->
  <a class="rail-home" href={url('/?letters=1')} aria-label="返回 izwarm 首页" title="返回首页">
    <img src={media.logoW} alt="" width="82" height="50" />
  </a>
</nav>
