---
import SeriesNode from './SeriesNode.astro';
import { buildSeriesTree } from '../../lib/notes';
import type { Note } from '../../lib/notes';

interface Props {
  notes: Note[];
}

const { notes } = Astro.props;
const tree = buildSeriesTree(notes);
---

<section class="notes-series" aria-label="笔记系列">
  {tree.length === 0 ? (
    <p class="notes-empty">暂无系列。</p>
  ) : (
    <div class="w-shape series-root">
      {tree.map((node) => <SeriesNode node={node} />)}
    </div>
  )}
</section>
