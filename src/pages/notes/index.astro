---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Landing from '../../components/home/Landing.astro';
import NotesSidebar from '../../components/notes/NotesSidebar.astro';
import HomeBoard from '../../components/home/HomeBoard.astro';
import { getPublishedNotes } from '../../lib/notes';

const notes = await getPublishedNotes();
---

<BaseLayout title="Notes · izwarm">
  <Landing open active="home">
    <Fragment slot="notes-left"><NotesSidebar notes={notes} /></Fragment>
    <Fragment slot="notes-main"><HomeBoard notes={notes} /></Fragment>
  </Landing>
</BaseLayout>
