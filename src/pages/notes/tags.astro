---
/**
 * 旧地址：/notes/tags/ 已经并进归档（标签是归档页顶部的那一条）。
 * 这里只留一个重定向存根，避免老链接 404。
 */
import { url } from '../../lib/notes';

const target = url('/notes/archive/');
---

<!doctype html>
<html lang="zh">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={target} />
    <title>Archive · izwarm</title>
  </head>
  <body>
    <script is:inline define:vars={{ target }}>
      location.replace(target);
    </script>
    <a href={target}>Archive</a>
  </body>
</html>
