---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Landing from '../../components/home/Landing.astro';
import ArticleSidebar from '../../components/notes/ArticleSidebar.astro';
import ArticleActions from '../../components/notes/ArticleActions.astro';
import { getCollection } from 'astro:content';
import { countWords, formatDate, getPublishedNotes, getSiblingNotes, url } from '../../lib/notes';
import type { Note } from '../../lib/notes';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes
    .filter((note) => !note.data.draft)
    .map((note) => ({ params: { slug: note.slug }, props: { note } }));
}

const { note } = Astro.props as { note: Note };
const { Content, headings } = await note.render();
const notes = await getPublishedNotes();
const siblings = getSiblingNotes(notes, note);
// 大纲包含一级标题：正文里的 `#` 标题是笔记自己的层级（如教材章），
// 排除 depth 1 会让"通篇只用 # 分节"的笔记（如 numpy 综合案例）大纲全空。
const toc = headings.filter((heading) => heading.depth >= 1 && heading.depth <= 4);
const words = countWords(note.body ?? '');
// 习题答案折叠块（<details class="answer">，见 docs/content-frontmatter.md）：
// 按原始正文判断，因为"渲染后 class 是否被保留"是渲染器的事，不是笔记的事。
// 两条判据对应 panel-nav.ts 里 initAnswerFolds 的同一套兜底：
// 首选 class="answer"，渲染器剥掉 class 时退回 summary 文本恰为「答案」的 details。
// 没有答案块的笔记（第 5 章目前只有题目）拿不到按钮，也不该多出一条空工具栏。
const answerFoldRe = /<details[^>]*\bclass="[^"]*\banswer\b[^"]*"|<details[^>]*>\s*<summary>\s*答案\s*<\/summary>/gi;
const answerCount = (note.body?.match(answerFoldRe) ?? []).length;
---

<BaseLayout title={`${note.data.title} · izwarm`}>
  <Landing open active="article">
    <Fragment slot="notes-left">
      <ArticleSidebar note={note} siblings={siblings} toc={toc} />
    </Fragment>
    <Fragment slot="notes-main">
      <article class="article">
        {note.data.cover && <img class="article-cover" src={url(note.data.cover)} alt="" />}
        <h1>{note.data.title}</h1>
        <div class="article-meta">
          <time datetime={formatDate(note.data.publishDate)}>发布于 {formatDate(note.data.publishDate)}</time>
          {note.data.updatedDate && (
            <time datetime={formatDate(note.data.updatedDate)}>更新于 {formatDate(note.data.updatedDate)}</time>
          )}
          {note.data.series.length > 0 && <span>{note.data.series.join(' / ')}</span>}
          {note.data.tags.map((tag) => (
            <a href={url(`/notes/tags/${encodeURIComponent(tag)}/`)}>#{tag}</a>
          ))}
          <span>{words} 字数</span>
        </div>
        {answerCount > 0 && (
          <div class="answer-toolbar">
            {/* 只做「全部」这一个按钮：单个答案块的展开/收起是浏览器原生
                <details> 行为，脚本不 preventDefault、不代管 open（见 panel-nav.ts）。
                换页由 SPA 原位替换区域内容，所以按钮不在这里绑监听，
                由 initAnswerFolds() 在每次替换后重新查一次。 */}
            <button
              class="answer-toggle"
              type="button"
              data-answer-toggle
              aria-expanded="false"
              title="切换全部习题答案"
            >
              <span class="answer-toggle-label" data-answer-toggle-label>展开全部答案</span>
              <span class="answer-toggle-count" data-answer-toggle-count>{answerCount} 题</span>
            </button>
          </div>
        )}
        <div class="article-body">
          <Content />
        </div>
      </article>
      <ArticleActions />
    </Fragment>
  </Landing>
</BaseLayout>
