---
/**
 * 旧地址：/notes/tags/<tag>/ 已经并进归档 —— 现在是「归档页 + ?tag= 预筛选」。
 * 这里只留一个重定向存根，避免老链接 404；落地页会自动把该标签筛上。
 */
import { getPublishedNotes, url } from '../../../lib/notes';

export async function getStaticPaths() {
  const notes = await getPublishedNotes();
  const tags = [...new Set(notes.flatMap((note) => note.data.tags))];
  return tags.map((tag) => ({ params: { tag }, props: { tag } }));
}

const { tag } = Astro.props as { tag: string };
const target = url(`/notes/archive/?tag=${encodeURIComponent(tag)}`);
---

<!doctype html>
<html lang="zh">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={target} />
    <title>#{tag} · izwarm</title>
  </head>
  <body>
    <script is:inline define:vars={{ target }}>
      location.replace(target);
    </script>
    <a href={target}>#{tag}</a>
  </body>
</html>
